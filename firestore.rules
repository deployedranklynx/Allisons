rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Read access to public ads and global settings
    match /adminSettings/{document} {
      allow read: if true;
      allow write: if true;
    }
    
    match /ads/{adId} {
      allow read: if true;
      allow write: if true;
    }
    
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
